# ── Google Cloud / Vertex AI ────────────────────────────────────────
# Required on Cloud Run (keyless auth via attached service account)
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=global

# ── Local development fallback ───────────────────────────────────────
# If set, overrides Vertex AI and uses the Gemini Developer API directly
GEMINI_API_KEY=

# ── CesiumJS Ion ─────────────────────────────────────────────────────
# Obtain a free token at https://ion.cesium.com
# If absent, the viewer falls back to EllipsoidTerrainProvider (no DEM)
VITE_CESIUM_ION_TOKEN=

# ── App ───────────────────────────────────────────────────────────────
PORT=8080
